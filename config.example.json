{
  "stateDir": "./state",
  "credentialsFile": "./credentials.json",
  "t3": {
    "origin": "http://127.0.0.1:3773",
    "executable": "auto",
    "prefix": [],
    "env": {}
  },
  "bridge": {
    "host": "127.0.0.1",
    "port": 18773,
    "proactiveBackgroundReports": false,
    "maxMessageChars": 1600
  },
  "gateway": {
    "bridgeUrl": "http://127.0.0.1:18773/events",
    "requireMentionInGroup": true,
    "stripPrefix": ""
  },
  "attachmentHosts": [
    "multimedia.nt.qq.com.cn",
    "multimedia.nt.qq.com",
    "gchat.qpic.cn",
    "c2cpicdw.qpic.cn",
    "qqbot.ugcimg.cn",
    "*.nt.qq.com.cn",
    "*.nt.qq.com",
    "*.ftn.qq.com",
    "*.qpic.cn",
    "*.ugcimg.cn",
    "*.gtimg.cn"
  ],
  "attachments": {
    "maxInboundBytes": 209715200,
    "maxPerMessage": 10,
    "downloadIdleTimeoutMs": 30000,
    "downloadTotalTimeoutMs": 300000,
    "uploadTimeoutMs": 120000
  },
  "bindings": [
    {
      "scope": "c2c:REPLACE_WITH_YOUR_USER_OPENID",
      "workspace": "/path/to/your/t3-project-workspace",
      "threadId": "REPLACE_WITH_T3_THREAD_ID_OR_LEAVE_EMPTY_TO_AUTO_CREATE"
    }
  ]
}
